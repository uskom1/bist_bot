# ==============================================================================
# 1. TELEGRAM BOT AYARLARI (Tarayıcı Bildirimleri & Mini App Doğrulaması İçin)
# ==============================================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Opsiyonel: Lokal CLI çalıştırmalarında varsayılan mod (morning_breakout | evening_squeeze)
SCAN_MODE=morning_breakout

# ==============================================================================
# 2. GITHUB ACTIONS TETİKLEME AYARLARI (Telegram Mini App Backend İçin)
# ==============================================================================
# GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
# İzinler: Actions (Read and write) yetkisi verilmiş token
GITHUB_TOKEN=YOUR_GITHUB_PAT_TOKEN_HERE

# GitHub kullanıcı adınız ve depo adınız (Örn: git@github.com:uskom1/bist_bot.git)
REPO_OWNER=uskom1
REPO_NAME=bist_bot

# Tetiklenecek workflow dosya adı ve dal (branch) adı
WORKFLOW_ID=bist_scanner.yml
GITHUB_REF=main

# Sunucu Portu (Lokal geliştirme veya bulut dağıtımı için)
PORT=8000
